// testOperacionTransparencia.wtest
import operacionTransparencia.*

class ObraPublicaConPanelDePrueba inherits CausaObraPublica {
    const juecesDePrueba

    override method jueces() = juecesDePrueba
}

describe "Punto 1 - Perjuicio economico" {
    test "Una causa conserva su caratula y sus jueces" {
        const causa = new CausaSoborno(
            caratula = "Soborno investigado", costoBase = 10,
            hayArrepentidos = true, jueces = ["Juez A", "Juez B"]
        )

        assert.equals("Soborno investigado", causa.caratula())
        assert.equals(#{"Juez A", "Juez B"}, causa.jueces().asSet())
    }

    test "Un soborno con arrepentidos suma un millon" {
        const causa = new CausaSoborno(caratula = "Soborno", costoBase = 10, hayArrepentidos = true)

        assert.equals(11, causa.calcularPerjuicioEconomico())
    }

    test "Un soborno sin arrepentidos suma dos millones" {
        const causa = new CausaSoborno(caratula = "Soborno", costoBase = 10, hayArrepentidos = false)

        assert.equals(12, causa.calcularPerjuicioEconomico())
    }

    test "La obra publica arranca con base tres y usa el mismo panel para todas las causas" {        const primera = new CausaObraPublica(caratula = "Ruta")
        const segunda = new CausaObraPublica(caratula = "Puente")

        assert.equals(3, primera.costoBase())
        assert.equals(3, segunda.costoBase())
        assert.that(primera.jueces().size() > 0)
        assert.equals(primera.jueces().asSet(), segunda.jueces().asSet())
    }

    test "La obra publica con exactamente dos jueces tiene un perjuicio de cinco millones" {
        const causa = new ObraPublicaConPanelDePrueba(
            caratula = "Ruta", juecesDePrueba = ["Juez A", "Juez B"]
        )

        assert.equals(5, causa.calcularPerjuicioEconomico())
    }

    test "La obra publica con tres jueces conserva el perjuicio de tres millones" {
        const causa = new ObraPublicaConPanelDePrueba(
            caratula = "Ruta", juecesDePrueba = ["Juez A", "Juez B", "Juez C"]
        )

        assert.equals(3, causa.calcularPerjuicioEconomico())
    }

    test "Una causa compleja suma los extras de sus subcausas aun cuando estan anidadas" {
        const soborno = new CausaSoborno(caratula = "Soborno", costoBase = 10, hayArrepentidos = true)
        const obra = new ObraPublicaConPanelDePrueba(
            caratula = "Ruta", juecesDePrueba = ["Juez A", "Juez B"]
        )
        const interna = new CausaCompleja(caratula = "Interna", costoBase = 20, causas = [obra])
        const externa = new CausaCompleja(caratula = "Externa", costoBase = 5, causas = [soborno, interna])

        assert.equals(8, externa.calcularPerjuicioEconomico())
    }
}

describe "Punto 2 - Asignacion de causas" {
    const causa = new CausaSoborno(
        caratula = "Soborno investigado",
        costoBase = 9,
        hayArrepentidos = true,
        jueces = ["Juez A", "Juez B"]
    )
    const asignadas = []

    test "Rechaza al ejecutivo sin patrimonio aunque tenga un juez amigo" {
        const funcionario = new Funcionario(
            puesto = ejecutivo, patrimonioActual = 0, juecesAmigos = ["Juez A"], causas = asignadas
        )

        assert.throwsExceptionLike(
            new UserException(message = "El funcionario debe tener un patrimonio positivo"),
            { funcionario.asignarCausa(causa) }
        )
        assert.equals([], asignadas)
    }

    test "Al ejecutivo le basta un juez amigo entre varios" {
        const funcionario = new Funcionario(
            puesto = ejecutivo, patrimonioActual = 1, juecesAmigos = ["Juez B", "Juez C"], causas = asignadas
        )

        funcionario.asignarCausa(causa)

        assert.equals([causa], asignadas)
    }

    test "Rechaza al ejecutivo que no tiene amigos entre los jueces de la causa" {
        const funcionario = new Funcionario(
            puesto = ejecutivo, patrimonioActual = 6, juecesAmigos = ["Juez C"], causas = asignadas
        )

        assert.throwsExceptionLike(
            new UserException(message = "No tiene un juez amigo en la causa"),
            { funcionario.asignarCausa(causa) }
        )
        assert.equals([], asignadas)
    }

    test "Rechaza al ministro que tiene exactamente la mitad del perjuicio" {
        const funcionario = new Funcionario(puesto = ministro, patrimonioActual = 5, causas = asignadas)

        assert.throwsExceptionLike(
            new UserException(message = "No tiene un patrimonio mayor al 50% del perjuicio de la causa"),
            { funcionario.asignarCausa(causa) }
        )
        assert.equals([], asignadas)
    }

    test "El ministro con mas de la mitad del perjuicio puede asumir la causa" {
        const funcionario = new Funcionario(puesto = ministro, patrimonioActual = 5.01, causas = asignadas)

        funcionario.asignarCausa(causa)

        assert.equals([causa], asignadas)
    }

    test "Al cambiar de puesto el mismo funcionario aplica la nueva regla" {
        const funcionario = new Funcionario(puesto = ejecutivo, patrimonioActual = 6, causas = asignadas)

        assert.throwsExceptionLike(
            new UserException(message = "No tiene un juez amigo en la causa"),
            { funcionario.asignarCausa(causa) }
        )
        assert.equals([], asignadas)

        funcionario.modificarPuesto(ministro)
        funcionario.asignarCausa(causa)

        assert.equals([causa], asignadas)
    }
}
describe "Punto 3 - Causas y medios" {
    const funcionario = new Funcionario(puesto = ministro, patrimonioActual = 100)

    method soborno(caratula, base) = new CausaSoborno(
        caratula = caratula, costoBase = base, hayArrepentidos = true
    )

    test "Solo devuelve las causas asignadas con perjuicio estrictamente mayor a cinco" {
        const menor = self.soborno("Menor al limite", 3)
        const limite = self.soborno("En el limite", 4)
        const mayor = self.soborno("Sobre el limite", 4.1)
        const otroFuncionario = new Funcionario(puesto = ministro, patrimonioActual = 100)
        otroFuncionario.asignarCausa(self.soborno("Asignada a otro funcionario", 9))
        funcionario.asignarCausa(menor)
        funcionario.asignarCausa(limite)
        funcionario.asignarCausa(mayor)

        assert.equals(#{mayor}, funcionario.causasQueLoDejanPegado().asSet())
    }

    test "Cada aparicion suma 0.1 al costo base de todas las causas asignadas" {
        const obra = new ObraPublicaConPanelDePrueba(
            caratula = "Ruta", juecesDePrueba = ["Juez A", "Juez B"]
        )
        const soborno = self.soborno("Soborno", 7)
        const ajena = self.soborno("Sin asignar", 4)
        funcionario.asignarCausa(obra)
        funcionario.asignarCausa(soborno)

        funcionario.saleEnMedios()

        assert.equals(3.1, obra.costoBase())
        assert.equals(7.1, soborno.costoBase())

        funcionario.saleEnMedios()

        assert.equals(3.2, obra.costoBase())
        assert.equals(7.2, soborno.costoBase())
        assert.equals(5.2, obra.calcularPerjuicioEconomico())
        assert.equals(4, ajena.costoBase())
    }

    test "Una causa que supera el limite despues de salir en medios entra en el filtro" {
        const causa = self.soborno("En el limite", 4)
        funcionario.asignarCausa(causa)
        assert.that(funcionario.causasQueLoDejanPegado().isEmpty())

        funcionario.saleEnMedios()

        assert.equals(5.1, causa.calcularPerjuicioEconomico())
        assert.equals(#{causa}, funcionario.causasQueLoDejanPegado().asSet())
    }
}

// Interfaz de prueba del punto 4: Funcionario.escucharPropuesta devuelve la promesa.
// Al postergar, se cuentan los cuatro anos desde la presentacion de la propuesta.
// Los casos del Ejecutivo usan "aumento" e "impuestos" como palabras de ejemplo.
describe "Punto 4 - Propuestas y promesas" {
    const presentacion = new Date(day = 12, month = 3, year = 2025)
    const finDeMandato = new Date(day = 12, month = 3, year = 2029)
    const funcionarioEjecutivo = new Funcionario(puesto = ejecutivo, patrimonioActual = 10)
    const funcionarioMinistro = new Funcionario(puesto = ministro, patrimonioActual = 10)

    method propuesta(descripcion, vencimiento) = new Propuesta(
        descripcion = descripcion,
        fechaPresentacion = presentacion,
        fechaCumplimiento = vencimiento
    )

    test "El Ejecutivo conserva la fecha si aparece una sola palabra clave" {
        const vencimiento = new Date(day = 12, month = 9, year = 2026)
        const propuesta = self.propuesta("Reducir impuestos a comercios", vencimiento)

        const promesa = funcionarioEjecutivo.escucharPropuesta(propuesta)

        assert.equals(vencimiento, promesa.fechaCumplimiento())
        assert.equals(propuesta.descripcion(), promesa.descripcion())
    }

    test "El Ejecutivo posterga una propuesta corta sin palabras clave" {
        const vencimiento = new Date(day = 12, month = 9, year = 2025)
        const propuesta = self.propuesta("Renovar la plaza del barrio", vencimiento)

        const promesa = funcionarioEjecutivo.escucharPropuesta(propuesta)

        assert.equals(finDeMandato, promesa.fechaCumplimiento())
        assert.equals(propuesta.descripcion(), promesa.descripcion())
    }

    test "El Ministro acepta una propuesta que dura un dia menos de un ano" {
        const vencimiento = new Date(day = 11, month = 3, year = 2026)

        const promesa = funcionarioMinistro.escucharPropuesta(
            self.propuesta("Renovar la plaza del barrio", vencimiento)
        )

        assert.equals(vencimiento, promesa.fechaCumplimiento())
    }

    test "El Ministro posterga al cumplirse exactamente un ano aunque haya palabra clave" {
        const vencimiento = new Date(day = 12, month = 3, year = 2026)

        const promesa = funcionarioMinistro.escucharPropuesta(
            self.propuesta("Evitar un aumento de tarifas", vencimiento)
        )

        assert.equals(finDeMandato, promesa.fechaCumplimiento())
    }

    test "El Ministro tambien posterga cuando la propuesta dura mas de un ano" {
        const vencimiento = new Date(day = 13, month = 3, year = 2026)

        const promesa = funcionarioMinistro.escucharPropuesta(
            self.propuesta("Renovar la plaza del barrio", vencimiento)
        )

        assert.equals(finDeMandato, promesa.fechaCumplimiento())
    }

    test "Un cambio de puesto cambia la forma de decidir la fecha de la promesa" {
        const vencimiento = new Date(day = 12, month = 9, year = 2026)
        const propuesta = self.propuesta("Reducir impuestos a comercios", vencimiento)

        assert.equals(vencimiento, funcionarioEjecutivo.escucharPropuesta(propuesta).fechaCumplimiento())
        funcionarioEjecutivo.modificarPuesto(ministro)

        assert.equals(finDeMandato, funcionarioEjecutivo.escucharPropuesta(propuesta).fechaCumplimiento())
    }
}